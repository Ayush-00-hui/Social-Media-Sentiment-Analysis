{
  "name": "Traccia \u2014 Full Automation Pipeline (Monitoring, Digest, Onboarding)",
  "meta": {
    "description": "PART A (nodes A1-A5): real-time poll every 30s, always logs a trend point, routes by severity. PART B (nodes B1-B7): severity-based alerts (Medium/High/Critical) to Slack/Email. PART C (nodes C1-C3): auto-resolution when a crisis clears. PART D (nodes D1-D5): daily digest at 9am \u2014 scrapes 200+ news articles, converts them into a plain-language paragraph summary, and emails it. PART E (nodes E1-E6): client registration, login-setup-link generation, and welcome email."
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      },
      "name": "A1. Timer - Every 30 Seconds",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        160,
        240
      ],
      "notes": "PART A start. Matches background_tasks.py ingestion cadence."
    },
    {
      "parameters": {
        "url": "https://diffuser-thousand-rule.ngrok-free.dev/api/current_sentiment",
        "options": {
          "timeout": 5000
        }
      },
      "name": "A2. Get Live Sentiment Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        380,
        240
      ],
      "notes": "Z-score, sentiment breakdown, crisis level for this cycle."
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.stats !== undefined}}",
              "value2": true
            }
          ]
        }
      },
      "name": "A3. Is Backend Reachable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        600,
        240
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sentiment_history_log (timestamp, z_score, negative_pct, crisis_level) VALUES (NOW(), {{$json.stats.zScore}}, {{$json.stats.negativePct}}, '{{$json.stats.activeCrisisLevel}}');"
      },
      "name": "A4. Save Trend Point To Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        820,
        160
      ],
      "notes": "Runs on every poll, crisis or not, so history has no gaps."
    },
    {
      "parameters": {
        "dataPropertyName": "={{$json.stats.activeCrisisLevel}}",
        "rules": {
          "rules": [
            {
              "value": "MEDIUM",
              "output": 0
            },
            {
              "value": "HIGH",
              "output": 1
            },
            {
              "value": "CRITICAL",
              "output": 2
            }
          ]
        },
        "fallbackOutput": 3
      },
      "name": "A5. Decide Severity Level",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        1040,
        160
      ],
      "notes": "PART A end / PART B and C begin. Output 0=Medium, 1=High, 2=Critical, 3=Normal (goes to Part C)."
    },
    {
      "parameters": {
        "url": "https://diffuser-thousand-rule.ngrok-free.dev/api/crisis_alerts",
        "options": {
          "timeout": 5000
        }
      },
      "name": "B2. Get Crisis Details (High)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1280,
        140
      ]
    },
    {
      "parameters": {
        "fromEmail": "alerts@traccia.ai",
        "toEmail": "={{$env.CRISIS_EMAIL_LIST || 'admin@traccia.ai'}}",
        "subject": "Traccia \u2014 HIGH severity crisis alert",
        "html": "<h2>HIGH severity brand sentiment crisis</h2><p><strong>Z-score:</strong> {{$json.stats.zScore}}s</p><p><strong>Negative:</strong> {{$json.stats.negativePct}}%</p><p><a href=\"https://social-media-sentiment-analysis-sandy.vercel.app\">Open dashboard</a></p>"
      },
      "name": "B4. Email - High Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1520,
        180
      ]
    },
    {
      "parameters": {
        "url": "https://diffuser-thousand-rule.ngrok-free.dev/api/crisis_alerts",
        "options": {
          "timeout": 5000
        }
      },
      "name": "B5. Get Crisis Details (Critical)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1280,
        260
      ]
    },
    {
      "parameters": {
        "fromEmail": "alerts@traccia.ai",
        "toEmail": "={{$env.CRISIS_EMAIL_LIST || 'admin@traccia.ai'}}",
        "subject": "\ud83d\udd34 URGENT: Traccia CRITICAL crisis",
        "html": "<h2 style=\"color:#c0392b\">CRITICAL brand sentiment crisis</h2><p><strong>Z-score:</strong> {{$json.stats.zScore}}s</p><p><strong>Negative:</strong> {{$json.stats.negativePct}}%</p><p><a href=\"https://social-media-sentiment-analysis-sandy.vercel.app\">Open dashboard now</a></p>"
      },
      "name": "B7. Email - Critical Urgent",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1520,
        380
      ],
      "notes": "PART B end."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM crisis_alerts WHERE status = 'ACTIVE' ORDER BY timestamp DESC LIMIT 1;"
      },
      "name": "C1. Check For Active Crisis",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1280,
        480
      ],
      "notes": "PART C start. Runs when severity is back to Normal - checks if there's a lingering ACTIVE record to close out."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE crisis_alerts SET status = 'RESOLVED', resolved_at = NOW() WHERE status = 'ACTIVE';"
      },
      "name": "C2. Mark Crisis Resolved",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1520,
        480
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "name": "D1. Timer - Daily 9AM",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        160,
        680
      ],
      "notes": "PART D start."
    },
    {
      "parameters": {
        "url": "https://diffuser-thousand-rule.ngrok-free.dev/api/tweets?limit=200",
        "options": {
          "timeout": 10000
        }
      },
      "name": "D2. Scrape 200+ News Articles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        380,
        680
      ],
      "notes": "Pulls at least 200 recent news articles for the daily summary (requires /api/tweets to accept a limit query param)."
    },
    {
      "parameters": {
        "jsCode": "const articles = items[0].json.tweets || items[0].json || [];\nconst total = articles.length;\nconst pos = articles.filter(t => t.sentiment === 'POSITIVE').length;\nconst neg = articles.filter(t => t.sentiment === 'NEGATIVE').length;\nconst neu = total - pos - neg;\nconst sampleNegative = articles.filter(t => t.sentiment === 'NEGATIVE').slice(0, 3).map(t => `\"${t.text}\"`).join(' ');\nconst paragraph = `Over the last 24 hours, ${total} news articles were analyzed. ${pos} were positive, ${neu} neutral, and ${neg} negative. ${neg > 0 ? 'Recent negative examples include: ' + sampleNegative : 'No significant negative activity was recorded.'}`;\nreturn [{ json: { paragraph, total, pos, neg, neu } }];"
      },
      "name": "D3. Convert Articles To Paragraph Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        600,
        680
      ],
      "notes": "Basic Code node - turns the raw article array into a plain-language paragraph, no external AI call needed."
    },
    {
      "parameters": {
        "url": "https://diffuser-thousand-rule.ngrok-free.dev/api/sentiment_history",
        "options": {
          "timeout": 5000
        }
      },
      "name": "D4. Get 24h Stats History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        820,
        680
      ]
    },
    {
      "parameters": {
        "fromEmail": "digest@traccia.ai",
        "toEmail": "={{$node[\"D2. Get Daily Sentiment Summary\"].json.stats.notification_emails.join(\",\")}}",
        "subject": "Traccia \u2014 Daily Sentiment Digest",
        "html": "<h2>Daily Sentiment Summary</h2><p>{{$node[\"D3. Convert Articles To Paragraph Summary\"].json.paragraph}}</p><p><a href=\"https://social-media-sentiment-analysis-sandy.vercel.app\">View full dashboard</a></p>"
      },
      "name": "D5. Email - Daily Digest",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1040,
        680
      ],
      "notes": "PART D end. Now reads like a real summary paragraph instead of raw numbers."
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "welcome-email",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "E1. Webhook - Welcome Email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        160,
        900
      ],
      "notes": "PART E start."
    },
    {
      "parameters": {
        "fromEmail": "hello@traccia.ai",
        "toEmail": "={{$json.body.email}}",
        "subject": "Welcome to Traccia!",
        "html": "<h2>Welcome to Traccia, {{$json.body.company_name}}!</h2><p>Your multi-tenant monitoring dashboard is ready.</p><p><a href=\"https://social-media-sentiment-analysis-sandy.vercel.app/login\">Log in here</a> with the password you just created.</p>"
      },
      "name": "E4. Send Welcome Email With Login Link",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        820,
        840
      ]
    },
    {
      "parameters": {
        "url": "https://news.google.com/rss/search?q=%22TechBrand%22%20OR%20%22CompetitorA%22&hl=en-US&gl=US&ceid=US:en"
      },
      "name": "A1a. Fetch Google News RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        160,
        420
      ],
      "notes": "NEW: Natively scrapes RSS feed."
    },
    {
      "parameters": {
        "jsCode": "const articles = [];\nfor (const item of items) {\n  articles.push({\n    id: item.json.guid || item.json.link,\n    text: item.json.title,\n    author: item.json.creator || 'News Publisher',\n    timestamp: item.json.pubDate\n  });\n}\nreturn [{ json: { articles } }];"
      },
      "name": "A1b. Map Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        380,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://diffuser-thousand-rule.ngrok-free.dev/api/ingest_news",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"articles\": {{$json.articles}} }",
        "options": {}
      },
      "name": "A1c. POST to Backend Ingestion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        600,
        420
      ]
    }
  ],
  "connections": {
    "A1. Timer - Every 30 Seconds": {
      "main": [
        [
          {
            "node": "A1a. Fetch Google News RSS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A2. Get Live Sentiment Stats": {
      "main": [
        [
          {
            "node": "A3. Is Backend Reachable?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A3. Is Backend Reachable?": {
      "main": [
        [
          {
            "node": "A4. Save Trend Point To Database",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "A4. Save Trend Point To Database": {
      "main": [
        [
          {
            "node": "A5. Decide Severity Level",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A5. Decide Severity Level": {
      "main": [
        [],
        [
          {
            "node": "B2. Get Crisis Details (High)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "B5. Get Crisis Details (Critical)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "C1. Check For Active Crisis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "B2. Get Crisis Details (High)": {
      "main": [
        [
          {
            "node": "B4. Email - High Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "B5. Get Crisis Details (Critical)": {
      "main": [
        [
          {
            "node": "B7. Email - Critical Urgent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "C1. Check For Active Crisis": {
      "main": [
        [
          {
            "node": "C2. Mark Crisis Resolved",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "C2. Mark Crisis Resolved": {
      "main": [
        []
      ]
    },
    "D1. Timer - Daily 9AM": {
      "main": [
        [
          {
            "node": "D2. Scrape 200+ News Articles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "D2. Scrape 200+ News Articles": {
      "main": [
        [
          {
            "node": "D3. Convert Articles To Paragraph Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "D3. Convert Articles To Paragraph Summary": {
      "main": [
        [
          {
            "node": "D4. Get 24h Stats History",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "D4. Get 24h Stats History": {
      "main": [
        [
          {
            "node": "D5. Email - Daily Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A1a. Fetch Google News RSS": {
      "main": [
        [
          {
            "node": "A1b. Map Articles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A1b. Map Articles": {
      "main": [
        [
          {
            "node": "A1c. POST to Backend Ingestion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A1c. POST to Backend Ingestion": {
      "main": [
        [
          {
            "node": "A2. Get Live Sentiment Stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "E1. Webhook - Welcome Email": {
      "main": [
        [
          {
            "node": "E4. Send Welcome Email With Login Link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}