# SentimentPulse AI - Environment Configuration Template

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://ayush_admin:secret_pass@postgres-db:5432/sentiment_db
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=sentiment_db
DB_USER=ayush_admin
DB_PASSWORD=secret_pass

# Twitter/X API Credentials
TWITTER_BEARER_TOKEN=test_bearer_token_12345

# n8n Automation Credentials
N8N_URL=http://n8n-automation:5678
N8N_USER=admin
N8N_PASSWORD=n8n_pass

# Gemini AI Integration (Optional)
GEMINI_API_KEY=test_gemini_api_key

# FastAPI Server Config
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Anomaly Threshold
Z_SCORE_THRESHOLD=2.5
