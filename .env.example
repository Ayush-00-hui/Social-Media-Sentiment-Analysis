# ===================================================
# TRACCIA PLATFORM - SECRETS & ENVIRONMENT VARIABLES SPEC
# ===================================================

# 1. DATABASE CONFIGURATION
# Local PostgreSQL URL: postgresql://username:password@localhost:5432/traccia_db
# Local SQLite Fallback: sqlite:///./traccia.db
DATABASE_URL=postgresql://ayush_admin:secret_pass@localhost:5432/traccia_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traccia_db
DB_USER=ayush_admin
DB_PASSWORD=secret_pass

# 2. TWITTER / X API V2 CREDENTIALS (Required for live Twitter stream)
# Get Bearer Token from https://developer.twitter.com
TWITTER_BEARER_TOKEN=test_bearer_token_12345

# 3. GOOGLE GEMINI API KEY (Optional - for advanced Gemini 3.6 Flash fallback)
# Get Key from https://ai.google.dev
GEMINI_API_KEY=test_gemini_api_key

# 4. N8N AUTOMATION WORKFLOW CONFIGURATION
N8N_URL=http://localhost:5678
N8N_USER=admin
N8N_PASSWORD=n8n_pass

# 5. FASTAPI BACKEND SERVER CONFIG
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# 6. FRONTEND API BASE URL (For Vercel deployment or local API routing)
# Leave empty for local Vite proxy, or set to your Ngrok / Cloud URL (e.g. https://your-ngrok.ngrok-free.app)
VITE_API_BASE_URL=http://localhost:8000

# 7. ANOMALY THRESHOLD & NOTIFICATIONS
Z_SCORE_THRESHOLD=2.5
CRISIS_EMAIL_LIST=admin@traccia.ai,oncall@traccia.ai

# 8. FEATURE FLAGS
DEMO_MODE=false
